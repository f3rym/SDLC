@startuml activity-postponement
' Диаграмма активности «Перенос срока» (UC-07, UC-08, UC-13), рисунок images/activity-postponement.png
title Перенос срока дедлайна (UC-07, UC-08, UC-13)

|Студент|
start
:Открыть карточку дедлайна;
:Нажать «Запросить перенос»;
repeat :Ввести новый срок и причину;
  |Система|
  :Проверить причину 10–500 символов\nи новый срок > сейчас (BR-04);
repeat while (Данные корректны?) is ([нет]) not ([да])
if (Дедлайн групповой?) then ([нет] личный)
  if (postponeCount < 2? (BR-05)) then ([да])
    :Записать изменение срока\n(UC-08, BR-07);
    :Пересчитать уровень эскалации;
  else ([нет])
    :Отказать: «Лимит переносов исчерпан»;
  endif
else ([да])
  :Создать PostponementRequest\nсо статусом PENDING;
  :Уведомление старосте>
  |Староста|
  :Решение по запросу<
  :Рассмотреть запрос;
  if (Одобрить? (BR-06)) then ([да])
    |Система|
    :Записать изменение срока\n(UC-08, автор — староста);
    :Пересчитать уровень эскалации;
    :Статус APPROVED;
  else ([нет])
    |Система|
    :Статус REJECTED;
  endif
  :Уведомить студента о решении;
endif
|Студент|
:Увидеть карточку\nс историей срока;
stop
@enduml
